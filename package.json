{
  "name": "@webship-js/drupal-core-steps",
  "version": "2.1.4",
  "description": "Drupal-core-specific Cucumber step definitions plugin for webship-js — BDD testing for the main pages of any Drupal core site (Playwright + Cucumber).",
  "main": "tests/step-definitions/drupal-core.steps.js",
  "files": [
    "tests/step-definitions/drupal-core.steps.js",
    "tests/step-definitions/drupal-access.steps.js",
    "tests/step-definitions/drupal-defaults.js",
    "tests/step-definitions/drupal-users.steps.js",
    "tests/step-definitions/drupal-helpers.js",
    "tests/step-definitions/drupal-form.steps.js",
    "tests/step-definitions/drupal-layout-builder.steps.js",
    "tests/step-definitions/drupal-site.steps.js",
    "tests/step-definitions/drupal-content-forms.steps.js",
    "tests/step-definitions/drupal-navigation.steps.js",
    "tests/selectors/drupal-core.json",
    "README.md",
    "LICENSE",
    "tests/features"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "webship-js",
    "drupal",
    "drupal-core",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "gherkin",
    "step-definitions",
    "drupal-testing",
    "e2e-testing"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/drupal-core-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/drupal-core-steps/issues"
  },
  "homepage": "https://github.com/webship/drupal-core-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.6"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "webship-js": "^2.0.6"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
